# Multi-stage build for Node.js service
FROM node:23-alpine AS base

WORKDIR /app

ENV ENV=dev \
    NODE_ENV=development \
    PNPM_HOME="/pnpm" \
    PATH="/pnpm:$PATH" \
    SHELL="/bin/sh"
    
# Install build tools and pnpm
RUN apk add --no-cache python3 make g++ curl && \
    npm install -g pnpm@10.10.0 && \
    pnpm setup && source /root/.bashrc && \
    pnpm add -g nodemon

# Dependencies stage
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN pnpm install --frozen-lockfile --prod --prefer-offline

# Development stage
FROM base AS dev
COPY --from=deps /app/node_modules ./node_modules
COPY . .

EXPOSE 50055
CMD ["pnpm", "dev:watch"]
